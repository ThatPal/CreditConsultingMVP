model User {
  id                      String                   @id @default(uuid()) @db.Uuid
  email                   String                   @unique
  name                    String                   @default("")
  emailVerified           Boolean                  @default(false)
  image                   String?
  authFirstName           String?
  authLastName            String?
  authPhone               String?
  authTimezone            String?
  authTermsAccepted       Boolean                  @default(false)
  twoFactorEnabled        Boolean                  @default(false)
  passwordHash            String?
  authProvider            String?
  role                    UserRole
  status                  UserStatus               @default(ACTIVE)
  lastLoginAt             DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  client                  Client?                  @relation("ClientIdentity")
  assignedClients         Client[]                 @relation("AssignedConsultant")
  sessions                AuthSession[]
  betterAuthSessions      BetterAuthSession[]
  betterAuthAccounts      BetterAuthAccount[]
  passwordResetTokens     PasswordResetToken[]
  workItems               WorkItem[]               @relation("WorkItemAssignee")
  auditEvents             AuditEvent[]             @relation("AuditActor")
  readinessDecisions      ReadinessAssessment[]    @relation("ReadinessConsultant")
  completedReviews        CreditReview[]           @relation("ReviewConsultant")
  createdSupportCases     SupportCase[]            @relation("SupportCaseCreator")
  assignedSupportCases    SupportCase[]            @relation("SupportCaseAssignee")
  supportMessages         SupportMessage[]         @relation("SupportMessageAuthor")
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  betterAuthTwoFactor     BetterAuthTwoFactor?
  staffAssignments        StaffClientAssignment[]  @relation("StaffAssignmentUser")
  accessGrants            ClientAccessGrant[]      @relation("AccessGrantGrantee")
  accessGrantsIssued      ClientAccessGrant[]      @relation("AccessGrantGrantor")
  accessGrantsRevoked     ClientAccessGrant[]      @relation("AccessGrantRevoker")
  securityEvents          SecurityEvent[]          @relation("SecurityEventActor")
  documentsUploaded       Document[]               @relation("DocumentUploader")
  supportAttachments      SupportAttachment[]      @relation("SupportAttachmentActor")
  paymentEvents           PaymentProviderEvent[]   @relation("PaymentEventActor")

  @@index([role, status])
}

model BetterAuthTwoFactor {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  secret                  String    @unique
  backupCodes             String
  userId                  String    @unique @db.Uuid
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime? @db.Timestamptz(3)
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BetterAuthSession {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expiresAt          DateTime  @db.Timestamptz(3)
  token              String    @unique
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)
  ipAddress          String?
  userAgent          String?
  userId             String    @db.Uuid
  staffMfaVerifiedAt DateTime? @db.Timestamptz(3)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model BetterAuthAccount {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  issuer                String
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
}

model BetterAuthVerification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@index([expiresAt])
}

model Client {
  id                       String                        @id @default(uuid()) @db.Uuid
  userId                   String?                       @unique @db.Uuid
  firstName                String
  lastName                 String
  phone                    String?
  status                   ClientStatus                  @default(ACTIVE)
  assignedConsultantId     String?                       @db.Uuid
  timezone                 String                        @default("America/New_York")
  termsAcceptedAt          DateTime
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt
  archivedAt               DateTime?
  user                     User?                         @relation("ClientIdentity", fields: [userId], references: [id], onDelete: Restrict)
  assignedConsultant       User?                         @relation("AssignedConsultant", fields: [assignedConsultantId], references: [id], onDelete: SetNull)
  goals                    ClientGoal[]
  goalRevisions            ClientGoalRevision[]
  consumedGoalIntakes      AnonymousGoalIntake[]
  servicePurchases         ServicePurchase[]
  reviewPlans              ReviewPlan[]
  creditSnapshots          CreditSnapshot[]
  planActions              PlanAction[]
  plans                    Plan[]
  workItems                WorkItem[]
  readinessAssessments     ReadinessAssessment[]
  auditEvents              AuditEvent[]
  creditReviews            CreditReview[]
  supportCases             SupportCase[]
  notifications            Notification[]
  cards                    ClientCard[]
  cardWishlist             ClientCardWishlist[]
  applicationCycles        ApplicationCycle[]
  creditCardRounds         CreditCardRound[]
  roundMajorChecks         RoundMajorApplicationCheck[]
  creditJourney            CreditJourney?
  nurturePeriods           NurturePeriod[]
  creditProfileState       CreditProfileState?
  businesses               ClientBusiness[]
  financialRelationships   ClientFinancialRelationship[]
  serviceEntitlements      ServiceEntitlement[]
  reviewCreditTransactions ReviewCreditTransaction[]
  payments                 Payment[]
  staffAssignments         StaffClientAssignment[]
  accessGrants             ClientAccessGrant[]
  securityEvents           SecurityEvent[]
  documents                Document[]
  clientUpdates            ClientUpdate[]

  @@index([assignedConsultantId, status])
}

model RoleCapability {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role       UserRole
  capability String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@unique([role, capability])
  @@index([capability, role])
}

model StaffClientAssignment {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staffUserId   String    @db.Uuid
  clientId      String    @db.Uuid
  activatedAt   DateTime  @default(now()) @db.Timestamptz(3)
  deactivatedAt DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  staffUser     User      @relation("StaffAssignmentUser", fields: [staffUserId], references: [id], onDelete: Cascade)
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([staffUserId, clientId])
  @@index([clientId, deactivatedAt])
  @@index([staffUserId, deactivatedAt])
}

model ClientAccessGrant {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  granteeId           String            @db.Uuid
  clientId            String            @db.Uuid
  scope               ClientAccessScope
  allowedCapabilities String[]
  reason              String
  reference           String?
  startsAt            DateTime          @db.Timestamptz(3)
  expiresAt           DateTime          @db.Timestamptz(3)
  revokedAt           DateTime?         @db.Timestamptz(3)
  grantorId           String            @db.Uuid
  revokerId           String?           @db.Uuid
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(3)
  grantee             User              @relation("AccessGrantGrantee", fields: [granteeId], references: [id], onDelete: Cascade)
  client              Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  grantor             User              @relation("AccessGrantGrantor", fields: [grantorId], references: [id], onDelete: Restrict)
  revoker             User?             @relation("AccessGrantRevoker", fields: [revokerId], references: [id], onDelete: SetNull)

  @@index([granteeId, clientId, startsAt, expiresAt, revokedAt])
  @@index([clientId, scope, revokedAt])
}

model SecurityEvent {
  id         String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?               @db.Uuid
  clientId   String?               @db.Uuid
  eventType  String
  severity   SecurityEventSeverity @default(INFO)
  category   String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime              @default(now()) @db.Timestamptz(3)
  actor      User?                 @relation("SecurityEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  client     Client?               @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@index([actorId, createdAt])
  @@index([clientId, createdAt])
}

model CreditSnapshot {
  id                      String                  @id @default(uuid()) @db.Uuid
  clientId                String                  @db.Uuid
  capturedAt              DateTime
  expiresAt               DateTime
  aggregateUtilization    Decimal?                @db.Decimal(5, 2)
  revolvingBalance        Decimal?                @db.Decimal(14, 2)
  revolvingLimit          Decimal?                @db.Decimal(14, 2)
  openAccounts            Int?
  recentInquiries         Int?
  derogatoryItems         Int?
  source                  String?
  experianScore           Int?
  equifaxScore            Int?
  transunionScore         Int?
  scoreModel              String?
  averageAccountAgeMonths Int?
  oldestAccountAgeMonths  Int?
  revolvingAccounts       Int?
  installmentAccounts     Int?
  closedAccounts          Int?
  latePayments            Int?
  collections             Int?
  chargeOffs              Int?
  bankruptcies            Int?
  paymentHistoryStatus    String?
  createdAt               DateTime                @default(now())
  client                  Client                  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  review                  CreditReview?
  accounts                CreditAccountSnapshot[]
  publication             PublishedCreditReview?

  @@index([clientId, capturedAt])
}

model ClientCard {
  id                 String                   @id @default(uuid()) @db.Uuid
  clientId           String                   @db.Uuid
  cardName           String
  issuer             String
  scope              ClientCardScope
  portfolioType      ClientCardPortfolioType  @default(PERSONAL_CREDIT)
  identityStatus     ClientCardIdentityStatus @default(CONFIRMED)
  maskedIdentifier   String?
  reportsToBureaus   Boolean?
  creditLimit        Decimal?                 @db.Decimal(14, 2)
  balance            Decimal?                 @db.Decimal(14, 2)
  accountStatus      ClientCardAccountStatus?
  applicationOutcome CardApplicationOutcome?
  applicationSource  CardApplicationSource?
  appliedAt          DateTime?
  openedAt           DateTime?
  closedAt           DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  client             Client                   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  cardProductId      String?                  @db.Uuid
  cardProduct        CardProduct?             @relation(fields: [cardProductId], references: [id], onDelete: SetNull)
  identityLinks      ClientCardIdentityLink[]

  @@index([clientId, accountStatus, issuer])
  @@index([clientId, portfolioType, identityStatus])
  @@index([clientId, applicationOutcome, appliedAt])
  @@index([cardProductId, identityStatus])
}

model CardIssuer {
  id          String        @id @default(uuid()) @db.Uuid
  slug        String        @unique
  name        String
  domain      String?
  logoAssetId String?       @db.Uuid
  aliases     String[]
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)
  products    CardProduct[]
}

model CardProduct {
  id                      String                   @id @default(uuid()) @db.Uuid
  issuerId                String                   @db.Uuid
  slug                    String                   @unique
  canonicalName           String
  displayName             String
  aliases                 String[]
  audience                ClientCardScope
  portfolioType           ClientCardPortfolioType
  secured                 Boolean                  @default(false)
  reportsToBureaus        Boolean?
  features                Json
  tags                    String[]
  lifecycle               CardProductLifecycle     @default(ACTIVE)
  currentOfferVersionId   String?                  @unique @db.Uuid
  currentInsightVersionId String?                  @unique @db.Uuid
  createdAt               DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                 @updatedAt @db.Timestamptz(3)
  retiredAt               DateTime?                @db.Timestamptz(3)
  issuer                  CardIssuer               @relation(fields: [issuerId], references: [id], onDelete: Restrict)
  offerVersions           CardOfferVersion[]       @relation("ProductOfferVersions")
  currentOfferVersion     CardOfferVersion?        @relation("CurrentCardOffer", fields: [currentOfferVersionId], references: [id], onDelete: SetNull)
  insightVersions         CardInsightVersion[]     @relation("ProductInsightVersions")
  currentInsightVersion   CardInsightVersion?      @relation("CurrentCardInsight", fields: [currentInsightVersionId], references: [id], onDelete: SetNull)
  clientCards             ClientCard[]
  clientCardIdentityLinks ClientCardIdentityLink[]
  wishlists               ClientCardWishlist[]
  sourceMappings          CardSourceMapping[]
  candidates              CardCatalogCandidate[]

  @@unique([issuerId, canonicalName])
