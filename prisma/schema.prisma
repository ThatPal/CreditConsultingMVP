generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CLIENT
  CONSULTANT
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
  INVITED
}

enum ClientStatus {
  LEAD
  ACTIVE
  PAUSED
  CLOSED
}

enum GoalType {
  ZERO_APR_CREDIT
  TOTAL_AVAILABLE_CREDIT
  BUSINESS_CREDIT
  PERSONAL_CREDIT
  BALANCE_TRANSFER_CAPACITY
  EXISTING_LIMIT_INCREASES
  REWARDS_POINTS_PORTFOLIO
}

enum GoalScope {
  PERSONAL
  BUSINESS
  BOTH
}

enum GoalPriority {
  PRIMARY
  SECONDARY
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  PAUSED
}

enum CardTypePreference {
  UNSECURED_PREFERRED
  OPEN_TO_SECURED
  SECURED_DESIRED
  NO_PREFERENCE
}

enum GoalOfferPreference {
  ZERO_APR
  BALANCE_TRANSFER
  REWARDS_POINTS
}

enum FeePreference {
  NO_ANNUAL_FEE_ONLY
  PROMOTIONAL_NO_FEE_ACCEPTABLE
  PREFER_NO_FEE_OPEN
  FEE_ACCEPTABLE
}

enum ClientCardScope {
  PERSONAL
  BUSINESS
}

enum ClientCardAccountStatus {
  OPEN
  CLOSED
}

enum ClientCardPortfolioType {
  PERSONAL_CREDIT
  BUSINESS_CREDIT
  SECURED
  NON_REPORTING
}

enum ClientCardIdentityStatus {
  CONFIRMED
  UNRESOLVED
}

enum CardApplicationOutcome {
  APPROVED
  DECLINED
  PENDING
}

enum CardApplicationSource {
  CLIENT
  CONSULTANT
}

enum ApplicationCycleStatus {
  ACTIVE
  COMPLETE
  CANCELLED
}

enum ApplicationCycleReadiness {
  READY
  ACTION_REQUIRED
  NOT_READY
}

enum ApplicationCycleStage {
  STARTED
  REVIEW_PURCHASE
  CREDIT_REVIEW
  CONSULTANT_DECISION
  POST_REVIEW_ACTIONS
  ROUND_PURCHASE
  STRATEGY
  APPLICATION_SEQUENCE
  APPLICATION_ROUND
  RESULTS
  POST_APPLICATION_ACTIONS
  FINAL_RESULTS
}

enum ApplicationCycleStepStatus {
  NOT_STARTED
  AVAILABLE
  IN_PROGRESS
  COMPLETE
  SKIPPED
  BLOCKED
}

enum JourneyStatus {
  ACTIVE
  PAUSED
  COMPLETE
}

enum NurturePeriodStatus {
  ACTIVE
  COMPLETE
  CANCELLED
}

enum CreditProfileStateStatus {
  NOT_AVAILABLE
  REVIEW_IN_PROGRESS
  CURRENT
  STALE
}

enum ServiceType {
  CREDIT_PROFILE_REVIEW
  CREDIT_CARD_ROUND
  MAJOR_APPLICATION_READINESS
}

enum PurchaseStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentProvider {
  PAYPAL
  STRIPE
  BOFA_MERCHANT
  MANUAL
  OTHER
}

enum StorageProvider {
  LOCAL_DISK
  S3_COMPATIBLE
}

enum DocumentStatus {
  AVAILABLE
  SUPERSEDED
  RETENTION_HOLD
  DELETED
}

enum ClientBusinessStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum FinancialRelationshipStatus {
  ACTIVE
  INACTIVE
  CLOSED
}

enum EntitlementStatus {
  ACTIVE
  RESERVED
  CONSUMED
  CANCELLED
  EXPIRED
}

enum ReviewCreditTransactionType {
  PURCHASE
  RESERVE
  RELEASE_RESERVATION
  CONSUME
  RESTORE
  EXPIRE
  ADMIN_ADJUSTMENT
}

enum PaymentState {
  PENDING
  AWAITING_CUSTOMER
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentEventDisposition {
  APPLIED
  DUPLICATE
  IGNORED
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  WON
  LOST
  CLOSED
}

enum ReconciliationStatus {
  SUCCEEDED
  CORRECTED
  BLOCKED
  FAILED
}

enum ServiceProductVersionStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum PlanActionKind {
  ACTION
  GUIDANCE
  MILESTONE
}

enum WorkItemAuthority {
  PLAN_PROJECTION
  ATTENTION_PROJECTION
  LEGACY_INDEPENDENT
}

enum ReviewFrequency {
  SEMIANNUAL
  QUARTERLY
  MONTHLY
}

enum ReviewPlanStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum WorkItemStatus {
  OPEN
  IN_PROGRESS
  WAITING
  COMPLETED
  CANCELLED
}

enum WorkItemPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum PlanActionStatus {
  READY
  IN_PROGRESS
  BLOCKED
  COMPLETED
  DEFERRED
  CANCELLED
}

enum PlanActionOwner {
  CLIENT
  CONSULTANT
  SYSTEM
}

enum ReadinessOutcome {
  APPLY_NOW
  PREPARE_FIRST
  WAIT
}

enum ReadinessStatus {
  DRAFT
  IN_REVIEW
  CONFIRMED
  SUPERSEDED
}

enum RiskLevel {
  LOW
  MODERATE
  HIGH
}

enum SupportCategory {
  ACCOUNT
  BILLING
  CREDIT_REVIEW
  DOCUMENTS
  APPLICATION_ROUND
  MAJOR_READINESS
  TECHNICAL
  OTHER
}

enum SupportPriority {
  NORMAL
  HIGH
  URGENT
}

enum SupportCaseStatus {
  OPEN
  WAITING_ON_SUPPORT
  WAITING_ON_CLIENT
  RESOLVED
  CLOSED
}

enum SupportContextType {
  GENERAL
  DOCUMENT
  REVIEW
  APPLICATION_SESSION
}

enum OptionKind {
  FINDING
  RECOMMENDATION
  RATIONALE
  ACTION_BUNDLE
  CHECKLIST
  SUPPORT_MACRO
}

enum CreditReviewStatus {
  PURCHASED
  INTAKE_REQUIRED
  INFORMATION_REQUESTED
  INFORMATION_RECEIVED
  CONSULTANT_REVIEW
  COMPLETE
  CANCELLED
}

enum GeneralReadiness {
  NEEDS_REVIEW
  UNDER_REVIEW
  HIGH
  MEDIUM
  LOW
  EXPIRED
}

enum ReviewRecommendation {
  PROCEED
  PROCEED_SELECTIVELY
  PREPARE_FIRST
  WAIT_NURTURE
  MAJOR_APPLICATION_PRIORITY
}

enum FindingSeverity {
  POSITIVE
  INFORMATIONAL
  CAUTION
  CRITICAL
}

enum OutboxEventStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  DELIVERED
  RETRY_SCHEDULED
  FAILED
}

enum IntegrationType {
  EMAIL
  STORAGE
  PAYMENT
  AI
  CALENDAR
  OTHER
}

enum IntegrationStatus {
  UNTESTED
  HEALTHY
  DEGRADED
  FAILED
  DISABLED
}

enum ClientAccessScope {
  READ
  CONSULTANT_WORK
  SUPPORT_ONLY
}

enum SecurityEventSeverity {
  INFO
  WARNING
  HIGH
}

model User {
  id                      String                   @id @default(uuid()) @db.Uuid
  email                   String                   @unique
  name                    String                   @default("")
  emailVerified           Boolean                  @default(false)
  image                   String?
  authFirstName           String?
  authLastName            String?
  authPhone               String?
  authTimezone            String?
  authTermsAccepted       Boolean                  @default(false)
  twoFactorEnabled        Boolean                  @default(false)
  passwordHash            String?
  authProvider            String?
  role                    UserRole
  status                  UserStatus               @default(ACTIVE)
  lastLoginAt             DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  client                  Client?                  @relation("ClientIdentity")
  assignedClients         Client[]                 @relation("AssignedConsultant")
  sessions                AuthSession[]
  betterAuthSessions      BetterAuthSession[]
  betterAuthAccounts      BetterAuthAccount[]
  passwordResetTokens     PasswordResetToken[]
  workItems               WorkItem[]               @relation("WorkItemAssignee")
  auditEvents             AuditEvent[]             @relation("AuditActor")
  readinessDecisions      ReadinessAssessment[]    @relation("ReadinessConsultant")
  completedReviews        CreditReview[]           @relation("ReviewConsultant")
  createdSupportCases     SupportCase[]            @relation("SupportCaseCreator")
  assignedSupportCases    SupportCase[]            @relation("SupportCaseAssignee")
  supportMessages         SupportMessage[]         @relation("SupportMessageAuthor")
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  betterAuthTwoFactor     BetterAuthTwoFactor?
  staffAssignments        StaffClientAssignment[]  @relation("StaffAssignmentUser")
  accessGrants            ClientAccessGrant[]      @relation("AccessGrantGrantee")
  accessGrantsIssued      ClientAccessGrant[]      @relation("AccessGrantGrantor")
  accessGrantsRevoked     ClientAccessGrant[]      @relation("AccessGrantRevoker")
  securityEvents          SecurityEvent[]          @relation("SecurityEventActor")
  documentsUploaded       Document[]               @relation("DocumentUploader")
  supportAttachments      SupportAttachment[]      @relation("SupportAttachmentActor")
  paymentEvents           PaymentProviderEvent[]   @relation("PaymentEventActor")

  @@index([role, status])
}

model BetterAuthTwoFactor {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  secret                  String    @unique
  backupCodes             String
  userId                  String    @unique @db.Uuid
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime? @db.Timestamptz(3)
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BetterAuthSession {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expiresAt          DateTime  @db.Timestamptz(3)
  token              String    @unique
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)
  ipAddress          String?
  userAgent          String?
  userId             String    @db.Uuid
  staffMfaVerifiedAt DateTime? @db.Timestamptz(3)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model BetterAuthAccount {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  issuer                String
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
}

model BetterAuthVerification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@index([expiresAt])
}

model Client {
  id                       String                        @id @default(uuid()) @db.Uuid
  userId                   String?                       @unique @db.Uuid
  firstName                String
  lastName                 String
  phone                    String?
  status                   ClientStatus                  @default(ACTIVE)
  assignedConsultantId     String?                       @db.Uuid
  timezone                 String                        @default("America/New_York")
  termsAcceptedAt          DateTime
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt
  archivedAt               DateTime?
  user                     User?                         @relation("ClientIdentity", fields: [userId], references: [id], onDelete: Restrict)
  assignedConsultant       User?                         @relation("AssignedConsultant", fields: [assignedConsultantId], references: [id], onDelete: SetNull)
  goals                    ClientGoal[]
  goalRevisions            ClientGoalRevision[]
  consumedGoalIntakes      AnonymousGoalIntake[]
  servicePurchases         ServicePurchase[]
  reviewPlans              ReviewPlan[]
  creditSnapshots          CreditSnapshot[]
  planActions              PlanAction[]
  workItems                WorkItem[]
  readinessAssessments     ReadinessAssessment[]
  auditEvents              AuditEvent[]
  creditReviews            CreditReview[]
  supportCases             SupportCase[]
  notifications            Notification[]
  cards                    ClientCard[]
  applicationCycles        ApplicationCycle[]
  creditJourney            CreditJourney?
  nurturePeriods           NurturePeriod[]
  creditProfileState       CreditProfileState?
  businesses               ClientBusiness[]
  financialRelationships   ClientFinancialRelationship[]
  serviceEntitlements      ServiceEntitlement[]
  reviewCreditTransactions ReviewCreditTransaction[]
  payments                 Payment[]
  staffAssignments         StaffClientAssignment[]
  accessGrants             ClientAccessGrant[]
  securityEvents           SecurityEvent[]
  documents                Document[]

  @@index([assignedConsultantId, status])
}

model RoleCapability {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role       UserRole
  capability String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@unique([role, capability])
  @@index([capability, role])
}

model StaffClientAssignment {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staffUserId   String    @db.Uuid
  clientId      String    @db.Uuid
  activatedAt   DateTime  @default(now()) @db.Timestamptz(3)
  deactivatedAt DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  staffUser     User      @relation("StaffAssignmentUser", fields: [staffUserId], references: [id], onDelete: Cascade)
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([staffUserId, clientId])
  @@index([clientId, deactivatedAt])
  @@index([staffUserId, deactivatedAt])
}

model ClientAccessGrant {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  granteeId           String            @db.Uuid
  clientId            String            @db.Uuid
  scope               ClientAccessScope
  allowedCapabilities String[]
  reason              String
  reference           String?
  startsAt            DateTime          @db.Timestamptz(3)
  expiresAt           DateTime          @db.Timestamptz(3)
  revokedAt           DateTime?         @db.Timestamptz(3)
  grantorId           String            @db.Uuid
  revokerId           String?           @db.Uuid
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(3)
  grantee             User              @relation("AccessGrantGrantee", fields: [granteeId], references: [id], onDelete: Cascade)
  client              Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  grantor             User              @relation("AccessGrantGrantor", fields: [grantorId], references: [id], onDelete: Restrict)
  revoker             User?             @relation("AccessGrantRevoker", fields: [revokerId], references: [id], onDelete: SetNull)

  @@index([granteeId, clientId, startsAt, expiresAt, revokedAt])
  @@index([clientId, scope, revokedAt])
}

model SecurityEvent {
  id         String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?               @db.Uuid
  clientId   String?               @db.Uuid
  eventType  String
  severity   SecurityEventSeverity @default(INFO)
  category   String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime              @default(now()) @db.Timestamptz(3)
  actor      User?                 @relation("SecurityEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  client     Client?               @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@index([actorId, createdAt])
  @@index([clientId, createdAt])
}

model CreditSnapshot {
  id                      String                  @id @default(uuid()) @db.Uuid
  clientId                String                  @db.Uuid
  capturedAt              DateTime
  expiresAt               DateTime
  aggregateUtilization    Decimal?                @db.Decimal(5, 2)
  revolvingBalance        Decimal?                @db.Decimal(14, 2)
  revolvingLimit          Decimal?                @db.Decimal(14, 2)
  openAccounts            Int?
  recentInquiries         Int?
  derogatoryItems         Int?
  source                  String?
  experianScore           Int?
  equifaxScore            Int?
  transunionScore         Int?
  scoreModel              String?
  averageAccountAgeMonths Int?
  oldestAccountAgeMonths  Int?
  revolvingAccounts       Int?
  installmentAccounts     Int?
  closedAccounts          Int?
  latePayments            Int?
  collections             Int?
  chargeOffs              Int?
  bankruptcies            Int?
  paymentHistoryStatus    String?
  createdAt               DateTime                @default(now())
  client                  Client                  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  review                  CreditReview?
  accounts                CreditAccountSnapshot[]

  @@index([clientId, capturedAt])
}

model ClientCard {
  id                 String                   @id @default(uuid()) @db.Uuid
  clientId           String                   @db.Uuid
  cardName           String
  issuer             String
  scope              ClientCardScope
  portfolioType      ClientCardPortfolioType    @default(PERSONAL_CREDIT)
  identityStatus     ClientCardIdentityStatus   @default(CONFIRMED)
  maskedIdentifier   String?
  reportsToBureaus   Boolean?
  creditLimit        Decimal?                 @db.Decimal(14, 2)
  balance            Decimal?                 @db.Decimal(14, 2)
  accountStatus      ClientCardAccountStatus?
  applicationOutcome CardApplicationOutcome?
  applicationSource  CardApplicationSource?
  appliedAt          DateTime?
  openedAt           DateTime?
  closedAt           DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  client             Client                   @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@index([clientId, accountStatus, issuer])
  @@index([clientId, portfolioType, identityStatus])
  @@index([clientId, applicationOutcome, appliedAt])
}

model ApplicationCycle {
  id                   String                     @id @default(uuid()) @db.Uuid
  clientId             String                     @db.Uuid
  journeyId            String                     @db.Uuid
  cycleNumber          Int
  season               String?
  year                 Int?
  displayName          String?
  status               ApplicationCycleStatus     @default(ACTIVE)
  currentStage         ApplicationCycleStage      @default(STARTED)
  readinessDecision    ApplicationCycleReadiness?
  madeItToApplications Boolean                    @default(false)
  finalResult          String?
  startedAt            DateTime                   @default(now())
  closedAt             DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  client               Client                     @relation(fields: [clientId], references: [id], onDelete: Restrict)
  journey              CreditJourney              @relation(fields: [journeyId], references: [id], onDelete: Restrict)
  goalSnapshot         CycleGoalSnapshot?
  steps                ApplicationCycleStep[]
  applications         CycleApplication[]

  @@unique([clientId, cycleNumber])
  @@index([clientId, status, startedAt])
  @@index([journeyId, startedAt])
}

model CreditJourney {
  id             String             @id @default(uuid()) @db.Uuid
  clientId       String             @unique @db.Uuid
  status         JourneyStatus      @default(ACTIVE)
  startedAt      DateTime           @default(now()) @db.Timestamptz(3)
  completedAt    DateTime?          @db.Timestamptz(3)
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(3)
  client         Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  cycles         ApplicationCycle[]
  nurturePeriods NurturePeriod[]

  @@index([status, updatedAt])
}

model CycleGoalSnapshot {
  id                 String                @id @default(uuid()) @db.Uuid
  cycleId            String                @unique @db.Uuid
  sourceGoalId       String                @db.Uuid
  sourceGoalVersion  Int
  goalType           GoalType
  scope              GoalScope
  targetAmount       Decimal?              @db.Decimal(14, 2)
  allowAnnualFee     Boolean
  cardTypePreference CardTypePreference
  offerPreferences   GoalOfferPreference[] @default([])
  feePreference      FeePreference
  preferenceNote     String?               @db.VarChar(500)
  capturedAt         DateTime              @default(now()) @db.Timestamptz(3)
  cycle              ApplicationCycle      @relation(fields: [cycleId], references: [id], onDelete: Restrict)

  @@index([sourceGoalId, capturedAt])
}

model NurturePeriod {
  id          String              @id @default(uuid()) @db.Uuid
  clientId    String              @db.Uuid
  journeyId   String              @db.Uuid
  status      NurturePeriodStatus @default(ACTIVE)
  reasonCode  String
  startedAt   DateTime            @default(now()) @db.Timestamptz(3)
  expectedEnd DateTime?           @db.Timestamptz(3)
  endedAt     DateTime?           @db.Timestamptz(3)
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)
  client      Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  journey     CreditJourney       @relation(fields: [journeyId], references: [id], onDelete: Restrict)

  @@index([clientId, status, startedAt])
  @@index([journeyId, startedAt])
}

model CreditProfileState {
  id             String                   @id @default(uuid()) @db.Uuid
  clientId       String                   @unique @db.Uuid
  status         CreditProfileStateStatus @default(NOT_AVAILABLE)
  sourceReviewId String?                  @db.Uuid
  effectiveAt    DateTime?                @db.Timestamptz(3)
  staleAt        DateTime?                @db.Timestamptz(3)
  createdAt      DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                 @updatedAt @db.Timestamptz(3)
  client         Client                   @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@index([status, updatedAt])
}

model ApplicationCycleStep {
  id          String                     @id @default(uuid()) @db.Uuid
  cycleId     String                     @db.Uuid
  stage       ApplicationCycleStage
  title       String
  description String?
  status      ApplicationCycleStepStatus @default(NOT_STARTED)
  sortOrder   Int
  sourceType  String?
  sourceId    String?                    @db.Uuid
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  cycle       ApplicationCycle           @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([cycleId, stage])
  @@index([cycleId, sortOrder])
}

model CycleApplication {
  id            String                 @id @default(uuid()) @db.Uuid
  cycleId       String                 @db.Uuid
  cardName      String
  issuer        String
  scope         ClientCardScope
  outcome       CardApplicationOutcome
  approvedLimit Decimal?               @db.Decimal(14, 2)
  submittedAt   DateTime
  createdAt     DateTime               @default(now())
  cycle         ApplicationCycle       @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([cycleId, submittedAt])
}

model CreditReview {
  id                       String                    @id @default(uuid()) @db.Uuid
  clientId                 String                    @db.Uuid
  purchaseId               String?                   @unique @db.Uuid
  consultantId             String?                   @db.Uuid
  status                   CreditReviewStatus        @default(INTAKE_REQUIRED)
  intendedReportDate       DateTime?                 @db.Date
  reservationExpiresAt     DateTime?                 @db.Timestamptz(3)
  generalReadiness         GeneralReadiness          @default(UNDER_REVIEW)
  recommendation           ReviewRecommendation?
  readinessExpiresAt       DateTime?
  nextReviewRecommendedAt  DateTime?
  clientSummary            String?
  internalNotes            String?
  submittedAt              DateTime?
  reviewStartedAt          DateTime?
  completedAt              DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  client                   Client                    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  purchase                 ServicePurchase?          @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  consultant               User?                     @relation("ReviewConsultant", fields: [consultantId], references: [id], onDelete: SetNull)
  intake                   ReviewIntake?
  findings                 ReviewFinding[]
  snapshot                 CreditSnapshot?           @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  snapshotId               String?                   @unique @db.Uuid
  reviewCreditTransactions ReviewCreditTransaction[]

  @@index([clientId, status, createdAt])
  @@index([clientId, intendedReportDate, createdAt])
  @@index([consultantId, status, updatedAt])
}

model ReviewIntake {
  id                      String                @id @default(uuid()) @db.Uuid
  reviewId                String                @unique @db.Uuid
  reportDocumentKey       String?
  reportSource            String?
  reportDate              DateTime?
  recentApplications      Json?
  accountUpdates          Json?
  creditAccountsConfirmed Boolean?
  creditAccountReviews    Json?
  materialChanges         Json?
  materialChangeDetails   Json?
  informationRequest      Json?
  informationRequestedAt  DateTime?
  informationResolvedAt   DateTime?
  clientConfirmedAt       DateTime?
  submittedAt             DateTime?
  reportDocumentId        String?               @unique @db.Uuid
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  review                  CreditReview          @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reportDocument          CreditReportDocument? @relation(fields: [reportDocumentId], references: [id], onDelete: Restrict)
}

model CreditReportDocument {
  id               String          @id @default(uuid()) @db.Uuid
  storageKey       String          @unique
  originalFileName String
  mimeType         String
  sizeBytes        Int
  sha256           String
  provider         String?
  storageProvider  StorageProvider @default(LOCAL_DISK)
  validationStatus CreditReportValidationStatus @default(UPLOADED)
  sourceEntered    String?
  sourceDetected   String?
  reportDateEntered DateTime?       @db.Date
  reportDateDetected DateTime?      @db.Date
  rejectionCode    String?
  rejectionReason  String?
  reportDate       DateTime?
  bureauCoverage   Json?
  uploadedByUserId String          @db.Uuid
  uploadedAt       DateTime        @default(now())
  supersededAt     DateTime?
  supersededById   String?          @unique @db.Uuid
  intake           ReviewIntake?
  supersededBy     CreditReportDocument? @relation("CreditReportReplacement", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes       CreditReportDocument? @relation("CreditReportReplacement")

  @@index([uploadedByUserId, uploadedAt])
}

enum CreditReportValidationStatus {
  UPLOADED
  VALIDATED
  NEEDS_STAFF_REVIEW
  ACCEPTED
  REJECTED
}

model DocumentType {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key                 String     @unique
  name                String
  allowedMimeTypes    String[]
  allowedExtensions   String[]
  maximumSizeBytes    Int
  clientVisible       Boolean    @default(false)
  clientUploadEnabled Boolean    @default(false)
  retentionCategory   String
  retentionDays       Int?
  enabled             Boolean    @default(true)
  createdAt           DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @db.Timestamptz(3)
  documents           Document[]

  @@index([enabled, clientUploadEnabled])
}

model Document {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId           String              @db.Uuid
  documentTypeId     String              @db.Uuid
  originalFileName   String
  displayFileName    String
  mimeType           String
  sizeBytes          Int
  sha256             String
  storageProvider    StorageProvider
  storageKey         String
  status             DocumentStatus      @default(AVAILABLE)
  clientVisible      Boolean
  uploadedByUserId   String              @db.Uuid
  source             String              @default("APPLICATION")
  uploadedAt         DateTime            @default(now()) @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  supersededAt       DateTime?           @db.Timestamptz(3)
  supersededById     String?             @unique @db.Uuid
  retentionCategory  String
  retainUntil        DateTime?           @db.Timestamptz(3)
  retentionHoldAt    DateTime?           @db.Timestamptz(3)
  deletedAt          DateTime?           @db.Timestamptz(3)
  client             Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  documentType       DocumentType        @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  uploadedBy         User                @relation("DocumentUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  supersededBy       Document?           @relation("DocumentReplacement", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes         Document?           @relation("DocumentReplacement")
  supportAttachments SupportAttachment[]

  @@unique([storageProvider, storageKey])
  @@index([clientId, status, uploadedAt])
  @@index([clientId, documentTypeId, status, uploadedAt])
  @@index([retainUntil, status])
}

model ReviewFinding {
  id          String          @id @default(uuid()) @db.Uuid
  reviewId    String          @db.Uuid
  optionId    String?         @db.Uuid
  code        String
  label       String
  description String?
  severity    FindingSeverity
  sortOrder   Int             @default(0)
  review      CreditReview    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  option      OptionTemplate? @relation("ReviewFindingOption", fields: [optionId], references: [id], onDelete: SetNull)

  @@unique([reviewId, code])
  @@index([reviewId, sortOrder])
}

model CreditAccountSnapshot {
  id                      String         @id @default(uuid()) @db.Uuid
  snapshotId              String         @db.Uuid
  creditorName            String
  maskedAccountNumber     String?
  accountType             String
  responsibility          String?
  scope                   GoalScope?
  openedAt                DateTime?
  creditLimit             Decimal?       @db.Decimal(14, 2)
  balance                 Decimal?       @db.Decimal(14, 2)
  paymentStatus           String?
  lastReportedAt          DateTime?
  promotionalAprExpiresAt DateTime?
  attentionStatus         String?
  isOpen                  Boolean        @default(true)
  snapshot                CreditSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId, creditorName])
}

model PlanAction {
  id                 String           @id @default(uuid()) @db.Uuid
  clientId           String           @db.Uuid
  title              String
  description        String?
  status             PlanActionStatus @default(READY)
  owner              PlanActionOwner
  kind               PlanActionKind   @default(ACTION)
  sourceType         String
  sourceId           String?          @db.Uuid
  dueAt              DateTime?
  completedAt        DateTime?
  sortOrder          Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  client             Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  projectedWorkItems WorkItem[]

  @@unique([sourceType, sourceId, title])
  @@index([clientId, status, sortOrder])
}

model ReadinessAssessment {
  id             String            @id @default(uuid()) @db.Uuid
  clientId       String            @db.Uuid
  consultantId   String?           @db.Uuid
  version        Int
  status         ReadinessStatus   @default(DRAFT)
  outcome        ReadinessOutcome?
  riskLevel      RiskLevel?
  scope          GoalScope
  targetAmount   Decimal           @db.Decimal(14, 2)
  intendedAt     DateTime?
  profileAsOf    DateTime?
  timingBandDays Int?
  overrideReason String?
  confirmedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  client         Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  consultant     User?             @relation("ReadinessConsultant", fields: [consultantId], references: [id], onDelete: SetNull)
  factors        ReadinessFactor[]

  @@unique([clientId, version])
  @@index([clientId, status])
}

model ReadinessFactor {
  id           String              @id @default(uuid()) @db.Uuid
  assessmentId String              @db.Uuid
  code         String
  selected     Boolean             @default(true)
  severity     RiskLevel?
  optionId     String?             @db.Uuid
  value        String?
  assessment   ReadinessAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  option       OptionTemplate?     @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@unique([assessmentId, code])
}

model WorkItem {
  id                  String            @id @default(uuid()) @db.Uuid
  clientId            String            @db.Uuid
  assigneeId          String?           @db.Uuid
  title               String
  domain              String
  status              WorkItemStatus    @default(OPEN)
  priority            WorkItemPriority  @default(NORMAL)
  suggestedNextAction String?
  dueAt               DateTime?
  completedAt         DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  authority           WorkItemAuthority @default(LEGACY_INDEPENDENT)
  planActionId        String?           @db.Uuid
  sourceType          String?
  sourceId            String?           @db.Uuid
  reasonCode          String?
  dedupeKey           String?
  deepLink            Json?
  neededSince         DateTime?
  claimedAt           DateTime?
  resolvedAt          DateTime?
  version             Int               @default(0)
  client              Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  assignee            User?             @relation("WorkItemAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  planAction          PlanAction?       @relation(fields: [planActionId], references: [id], onDelete: SetNull)

  @@index([assigneeId, status, priority, dueAt])
  @@index([clientId, status])
  @@index([planActionId, status])
  @@index([sourceType, sourceId])
  @@index([status, priority, neededSince, id])
  @@index([dedupeKey, status])
}

model SupportCase {
  id                 String                    @id @default(uuid()) @db.Uuid
  clientId           String                    @db.Uuid
  createdByUserId    String                    @db.Uuid
  assignedToUserId   String?                   @db.Uuid
  category           SupportCategory
  priority           SupportPriority           @default(NORMAL)
  status             SupportCaseStatus         @default(WAITING_ON_SUPPORT)
  subject            String
  contextType        SupportContextType        @default(GENERAL)
  contextResourceId  String?                   @db.Uuid
  lastMessageAt      DateTime                  @default(now())
  clientReadAt       DateTime?
  staffReadAt        DateTime?
  resolvedAt         DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  client             Client                    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdBy          User                      @relation("SupportCaseCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  assignedTo         User?                     @relation("SupportCaseAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  messages           SupportMessage[]
  attachments        SupportAttachment[]
  categoryDefinition SupportCategoryDefinition @relation(fields: [category], references: [key], onDelete: Restrict)

  @@index([clientId, status, lastMessageAt])
  @@index([assignedToUserId, status, priority, lastMessageAt])
}

model SupportCategoryDefinition {
  key                 SupportCategory      @id
  name                String
  enabled             Boolean              @default(true)
  clientVisible       Boolean              @default(true)
  allowedContextTypes SupportContextType[]
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(3)
  tickets             SupportCase[]

  @@index([enabled, clientVisible])
}

model SupportMessage {
  id             String      @id @default(uuid()) @db.Uuid
  supportCaseId  String      @db.Uuid
  authorUserId   String      @db.Uuid
  body           String
  idempotencyKey String?
  internal       Boolean     @default(false)
  createdAt      DateTime    @default(now())
  supportCase    SupportCase @relation(fields: [supportCaseId], references: [id], onDelete: Cascade)
  author         User        @relation("SupportMessageAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@unique([supportCaseId, authorUserId, idempotencyKey])
  @@index([supportCaseId, createdAt])
}

model SupportAttachment {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supportCaseId    String      @db.Uuid
  documentId       String      @db.Uuid
  attachedByUserId String      @db.Uuid
  createdAt        DateTime    @default(now()) @db.Timestamptz(3)
  supportCase      SupportCase @relation(fields: [supportCaseId], references: [id], onDelete: Cascade)
  document         Document    @relation(fields: [documentId], references: [id], onDelete: Restrict)
  attachedBy       User        @relation("SupportAttachmentActor", fields: [attachedByUserId], references: [id], onDelete: Restrict)

  @@unique([supportCaseId, documentId])
  @@index([documentId])
}

model Notification {
  id          String                 @id @default(uuid()) @db.Uuid
  userId      String                 @db.Uuid
  clientId    String?                @db.Uuid
  semanticKey String
  type        String
  category    String                 @default("OPERATIONAL")
  title       String
  body        String
  safePayload Json?
  link        String?
  seenAt      DateTime?              @db.Timestamptz(3)
  readAt      DateTime?
  createdAt   DateTime               @default(now()) @db.Timestamptz(3)
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client      Client?                @relation(fields: [clientId], references: [id], onDelete: SetNull)
  deliveries  NotificationDelivery[]

  @@unique([userId, semanticKey])
  @@index([userId, readAt, createdAt])
  @@index([clientId, createdAt])
}

model NotificationDelivery {
  id                String                     @id @default(uuid()) @db.Uuid
  notificationId    String                     @db.Uuid
  channel           NotificationChannel
  provider          String
  status            NotificationDeliveryStatus @default(PENDING)
  attemptCount      Int                        @default(0)
  providerMessageId String?
  nextAttemptAt     DateTime?                  @db.Timestamptz(3)
  lastAttemptAt     DateTime?                  @db.Timestamptz(3)
  deliveredAt       DateTime?                  @db.Timestamptz(3)
  failureCategory   String?
  createdAt         DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                   @updatedAt @db.Timestamptz(3)
  notification      Notification               @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel, provider])
  @@index([status, nextAttemptAt, createdAt])
}

model NotificationTemplate {
  id           String              @id @default(uuid()) @db.Uuid
  key          String
  version      Int
  channel      NotificationChannel
  subject      String?
  body         String
  enabled      Boolean             @default(true)
  safeMetadata Json?
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)

  @@unique([key, version, channel])
  @@index([key, channel, enabled])
}

model NotificationPreference {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @db.Uuid
  category  String
  channel   NotificationChannel
  enabled   Boolean             @default(true)
  createdAt DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt DateTime            @updatedAt @db.Timestamptz(3)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, channel])
  @@index([userId, channel])
}

model Integration {
  id                    String            @id @default(uuid()) @db.Uuid
  key                   String            @unique
  type                  IntegrationType
  provider              String
  enabled               Boolean           @default(false)
  status                IntegrationStatus @default(UNTESTED)
  configurationMetadata Json?
  secretReferences      String[]
  lastTestedAt          DateTime?         @db.Timestamptz(3)
  lastSuccessAt         DateTime?         @db.Timestamptz(3)
  lastErrorCategory     String?
  createdAt             DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @db.Timestamptz(3)

  @@index([type, enabled, status])
}

model OptionTemplate {
  id             String            @id @default(uuid()) @db.Uuid
  code           String
  kind           OptionKind
  version        Int
  label          String
  description    String?
  payload        Json?
  active         Boolean           @default(true)
  createdAt      DateTime          @default(now())
  retiredAt      DateTime?
  factors        ReadinessFactor[]
  reviewFindings ReviewFinding[]   @relation("ReviewFindingOption")

  @@unique([code, version])
  @@index([kind, active])
}

model AuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  clientId      String?  @db.Uuid
  actorId       String?  @db.Uuid
  action        String
  entityType    String
  entityId      String?
  source        String   @default("APPLICATION")
  requestId     String?
  correlationId String?
  metadata      Json?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  client        Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  actor         User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@index([correlationId])
}

model OutboxEvent {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType      String
  eventKey       String            @unique
  aggregateType  String
  aggregateId    String?
  payload        Json
  payloadVersion Int               @default(1)
  status         OutboxEventStatus @default(PENDING)
  availableAt    DateTime          @default(now()) @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  publishedAt    DateTime?         @db.Timestamptz(3)
  attemptCount   Int               @default(0)
  lastAttemptAt  DateTime?         @db.Timestamptz(3)
  lastErrorCode  String?

  @@index([status, availableAt, createdAt])
  @@index([aggregateType, aggregateId, createdAt])
}

model IdempotencyRecord {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope       String
  subjectId   String
  operation   String
  key         String
  requestHash String?
  status      IdempotencyStatus @default(PROCESSING)
  result      Json?
  errorCode   String?
  startedAt   DateTime          @default(now()) @db.Timestamptz(3)
  completedAt DateTime?         @db.Timestamptz(3)
  failedAt    DateTime?         @db.Timestamptz(3)
  expiresAt   DateTime?         @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)

  @@unique([scope, subjectId, operation, key])
  @@index([status, expiresAt])
  @@index([subjectId, operation, createdAt])
}

model ServicePurchase {
  id                       String                    @id @default(uuid()) @db.Uuid
  clientId                 String                    @db.Uuid
  serviceType              ServiceType
  productVersionId         String?                   @db.Uuid
  termsSnapshot            Json?
  amount                   Decimal                   @db.Decimal(12, 2)
  currency                 String                    @default("USD")
  status                   PurchaseStatus            @default(PENDING)
  paymentProvider          PaymentProvider?
  paymentReference         String?
  purchasedAt              DateTime?
  refundedAt               DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  client                   Client                    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  productVersion           ServiceProductVersion?    @relation(fields: [productVersionId], references: [id], onDelete: Restrict)
  creditReview             CreditReview?
  entitlements             ServiceEntitlement[]
  payments                 Payment[]
  reviewCreditTransactions ReviewCreditTransaction[]

  @@index([clientId, createdAt])
  @@index([status, serviceType])
  @@index([productVersionId, createdAt])
}

model ClientBusiness {
  id                     String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId               String                        @db.Uuid
  legalName              String
  displayName            String?
  entityType             String?
  industry               String?
  formedAt               DateTime?
  ownershipPercent       Decimal?                      @db.Decimal(5, 2)
  status                 ClientBusinessStatus          @default(ACTIVE)
  version                Int                           @default(1)
  archivedAt             DateTime?
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
  client                 Client                        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  financialRelationships ClientFinancialRelationship[]

  @@index([clientId, status])
}

model ClientFinancialRelationship {
  id                    String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId              String                      @db.Uuid
  clientBusinessId      String?                     @db.Uuid
  institutionName       String
  relationshipType      String
  relationshipStartedAt DateTime?
  approximateTenure     String?
  status                FinancialRelationshipStatus @default(ACTIVE)
  version               Int                         @default(1)
  closedAt              DateTime?
  clientNote            String?
  source                String?
  lastConfirmedAt       DateTime?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  client                Client                      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  clientBusiness        ClientBusiness?             @relation(fields: [clientBusinessId], references: [id], onDelete: SetNull)

  @@index([clientId, status, institutionName])
  @@index([clientBusinessId])
}

model ServiceEntitlement {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId         String                 @db.Uuid
  purchaseId       String?                @db.Uuid
  productVersionId String?                @db.Uuid
  sourceKey        String?                @unique
  serviceType      ServiceType
  quantityGranted  Int                    @default(1)
  quantityUsed     Int                    @default(0)
  status           EntitlementStatus      @default(ACTIVE)
  grantedAt        DateTime               @default(now())
  reservedAt       DateTime?
  consumedAt       DateTime?
  expiresAt        DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  client           Client                 @relation(fields: [clientId], references: [id], onDelete: Restrict)
  purchase         ServicePurchase?       @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  productVersion   ServiceProductVersion? @relation(fields: [productVersionId], references: [id], onDelete: Restrict)

  @@index([clientId, serviceType, status])
  @@index([purchaseId])
  @@index([productVersionId])
}

model ReviewCreditTransaction {
  id                 String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId           String                      @db.Uuid
  purchaseId         String?                     @db.Uuid
  productVersionId   String?                     @db.Uuid
  sourceKey          String?                     @unique
  correlationId      String?
  reviewId           String?                     @db.Uuid
  transactionType    ReviewCreditTransactionType
  availableDelta     Int                         @default(0)
  reservedDelta      Int                         @default(0)
  consumedDelta      Int                         @default(0)
  expiredDelta       Int                         @default(0)
  reason             String?
  authorizedByUserId String?                     @db.Uuid
  createdAt          DateTime                    @default(now())
  client             Client                      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  purchase           ServicePurchase?            @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  productVersion     ServiceProductVersion?      @relation(fields: [productVersionId], references: [id], onDelete: Restrict)
  review             CreditReview?               @relation(fields: [reviewId], references: [id], onDelete: Restrict)

  @@index([clientId, createdAt])
  @@index([purchaseId])
  @@index([reviewId])
  @@index([productVersionId])
  @@index([correlationId])
}

model Payment {
  id                      String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId                String          @db.Uuid
  purchaseId              String          @db.Uuid
  provider                PaymentProvider
  state                   PaymentState    @default(PENDING)
  amount                  Decimal         @db.Decimal(12, 2)
  currency                String          @default("USD")
  providerPaymentId       String?
  providerOrderId         String?
  providerCustomerId      String?
  checkoutUrl             String?
  providerEnvironment     String          @default("SANDBOX")
  lastErrorCode           String?
  verifiedProviderEventId String?
  occurredAt              DateTime?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  client                  Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  purchase                ServicePurchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  providerEvents          PaymentProviderEvent[]
  refunds                 PaymentRefund[]
  disputes                PaymentDispute[]
  reconciliationAttempts PaymentReconciliation[]

  @@unique([provider, verifiedProviderEventId])
  @@index([purchaseId, createdAt])
  @@index([clientId, state, createdAt])
  @@index([provider, providerOrderId])
  @@index([provider, providerPaymentId])
}

model PaymentGatewayConfig {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider              PaymentProvider @unique
  environment           String          @default("SANDBOX")
  configured            Boolean         @default(false)
  connected             Boolean         @default(false)
  enabledForNewPayments Boolean         @default(false)
  defaultForCheckout    Boolean         @default(false)
  status                IntegrationStatus @default(UNTESTED)
  configurationMetadata Json?
  secretReferences      String[]
  lastTestedAt          DateTime?       @db.Timestamptz(3)
  lastSuccessAt         DateTime?       @db.Timestamptz(3)
  lastErrorCategory     String?
  version               Int             @default(1)
  createdAt             DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime        @updatedAt @db.Timestamptz(3)

  @@index([enabledForNewPayments, defaultForCheckout])
}

model PaymentRefund {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId        String          @db.Uuid
  purchaseId       String          @db.Uuid
  clientId         String          @db.Uuid
  provider         PaymentProvider
  providerRefundId String?
  idempotencyKey   String
  amount           Decimal         @db.Decimal(12, 2)
  currency         String
  status           RefundStatus    @default(REQUESTED)
  reason           String?
  actorId          String?         @db.Uuid
  source           String          @default("ADMIN")
  requestedAt      DateTime        @default(now()) @db.Timestamptz(3)
  completedAt      DateTime?       @db.Timestamptz(3)
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @db.Timestamptz(3)
  payment          Payment         @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([paymentId, idempotencyKey])
  @@unique([provider, providerRefundId])
  @@index([paymentId, status, createdAt])
  @@index([clientId, createdAt])
}

model PaymentDispute {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId         String          @db.Uuid
  clientId          String          @db.Uuid
  provider          PaymentProvider
  providerDisputeId String
  status            DisputeStatus   @default(OPEN)
  amount            Decimal?        @db.Decimal(12, 2)
  currency          String?
  reason            String?
  category          String?
  evidenceDueAt     DateTime?       @db.Timestamptz(3)
  providerOccurredAt DateTime?      @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)
  payment           Payment         @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([provider, providerDisputeId])
  @@index([paymentId, status, createdAt])
}

model PaymentReconciliation {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId        String               @db.Uuid
  provider         PaymentProvider
  idempotencyKey   String
  status           ReconciliationStatus
  beforeState      PaymentState
  providerState    PaymentState?
  corrected        Boolean              @default(false)
  errorCode        String?
  actorId          String?              @db.Uuid
  createdAt        DateTime             @default(now()) @db.Timestamptz(3)
  payment          Payment              @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([paymentId, idempotencyKey])
  @@index([paymentId, createdAt])
}

model PaymentProviderEvent {
  id                String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider          PaymentProvider
  providerEventId   String
  eventType         String
  disposition       PaymentEventDisposition @default(APPLIED)
  normalizedState   PaymentState?
  paymentId         String?                 @db.Uuid
  actorId           String?                 @db.Uuid
  safeMetadata      Json?
  occurredAt        DateTime?               @db.Timestamptz(3)
  verifiedAt        DateTime                @default(now()) @db.Timestamptz(3)
  createdAt         DateTime                @default(now()) @db.Timestamptz(3)
  payment           Payment?                @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  actor             User?                   @relation("PaymentEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([paymentId, createdAt])
  @@index([provider, createdAt])
}

model ServiceDefinition {
  serviceType ServiceType @id
  price       Decimal     @db.Decimal(12, 2)
  currency    String      @default("USD")
  active      Boolean     @default(true)
  updatedAt   DateTime    @updatedAt
}

model ServiceProduct {
  id             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key            String                  @unique
  active         Boolean                 @default(false)
  currentVersion Int?
  createdAt      DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @db.Timestamptz(3)
  versions       ServiceProductVersion[]

  @@index([active, updatedAt])
}

model ServiceProductVersion {
  id                       String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceProductId         String                      @db.Uuid
  version                  Int
  status                   ServiceProductVersionStatus @default(DRAFT)
  name                     String
  description              String
  price                    Decimal                     @db.Decimal(12, 2)
  currency                 String                      @default("USD")
  entitlementType          ServiceType
  includedQuantity         Int                         @default(1)
  includedReviewCredits    Int                         @default(0)
  prerequisiteCode         String?
  clientEligibilityCopy    String?
  effectiveAt              DateTime?                   @db.Timestamptz(3)
  createdAt                DateTime                    @default(now()) @db.Timestamptz(3)
  serviceProduct           ServiceProduct              @relation(fields: [serviceProductId], references: [id], onDelete: Restrict)
  purchases                ServicePurchase[]
  entitlements             ServiceEntitlement[]
  reviewCreditTransactions ReviewCreditTransaction[]

  @@unique([serviceProductId, version])
  @@index([status, effectiveAt])
  @@index([entitlementType])
}

model ReviewPlan {
  id                     String           @id @default(uuid()) @db.Uuid
  clientId               String           @db.Uuid
  frequency              ReviewFrequency
  status                 ReviewPlanStatus @default(ACTIVE)
  price                  Decimal          @db.Decimal(12, 2)
  currency               String           @default("USD")
  paymentProvider        PaymentProvider
  providerSubscriptionId String?
  startedAt              DateTime         @default(now())
  nextReviewAt           DateTime?
  endedAt                DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  client                 Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@index([clientId, status])
}

model ClientGoal {
  id                 String                @id @default(uuid()) @db.Uuid
  clientId           String                @db.Uuid
  goalType           GoalType
  scope              GoalScope
  targetAmount       Decimal?              @db.Decimal(14, 2)
  currentAmount      Decimal?              @db.Decimal(14, 2)
  allowAnnualFee     Boolean               @default(false)
  cardTypePreference CardTypePreference    @default(NO_PREFERENCE)
  offerPreferences   GoalOfferPreference[] @default([])
  feePreference      FeePreference         @default(NO_ANNUAL_FEE_ONLY)
  preferenceNote     String?               @db.VarChar(500)
  priority           GoalPriority
  status             GoalStatus            @default(ACTIVE)
  version            Int                   @default(1)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  achievedAt         DateTime?
  client             Client                @relation(fields: [clientId], references: [id], onDelete: Restrict)
  revisions          ClientGoalRevision[]

  @@unique([clientId, goalType, scope])
  @@index([clientId, status, priority])
}

model ClientGoalRevision {
  id                 String                @id @default(uuid()) @db.Uuid
  goalId             String                @db.Uuid
  clientId           String                @db.Uuid
  version            Int
  goalType           GoalType
  scope              GoalScope
  targetAmount       Decimal?              @db.Decimal(14, 2)
  allowAnnualFee     Boolean
  cardTypePreference CardTypePreference    @default(NO_PREFERENCE)
  offerPreferences   GoalOfferPreference[] @default([])
  feePreference      FeePreference         @default(NO_ANNUAL_FEE_ONLY)
  preferenceNote     String?               @db.VarChar(500)
  priority           GoalPriority
  status             GoalStatus
  changedById        String?               @db.Uuid
  changeSource       String                @default("CLIENT_COMMAND")
  createdAt          DateTime              @default(now()) @db.Timestamptz(3)
  goal               ClientGoal            @relation(fields: [goalId], references: [id], onDelete: Restrict)
  client             Client                @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@unique([goalId, version])
  @@index([clientId, createdAt])
}

model AnonymousGoalIntake {
  id                 String                @id @default(uuid()) @db.Uuid
  tokenHash          String                @unique
  goalType           GoalType
  scope              GoalScope
  targetAmount       Decimal               @db.Decimal(14, 2)
  allowAnnualFee     Boolean               @default(false)
  cardTypePreference CardTypePreference    @default(NO_PREFERENCE)
  offerPreferences   GoalOfferPreference[] @default([])
  feePreference      FeePreference         @default(NO_ANNUAL_FEE_ONLY)
  preferenceNote     String?               @db.VarChar(500)
  firstName          String                @db.VarChar(100)
  lastName           String                @db.VarChar(100)
  email              String                @db.VarChar(320)
  phone              String?               @db.VarChar(32)
  version            Int                   @default(1)
  expiresAt          DateTime              @db.Timestamptz(3)
  consumedAt         DateTime?             @db.Timestamptz(3)
  consumedByClientId String?               @db.Uuid
  createdAt          DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime              @updatedAt @db.Timestamptz(3)
  consumedByClient   Client?               @relation(fields: [consumedByClientId], references: [id], onDelete: Restrict)

  @@index([expiresAt, consumedAt])
  @@index([consumedByClientId])
}

model GoalIntakeRegistrationClaim {
  id                    String   @id @default(uuid()) @db.Uuid
  registrationEmailHash String   @unique
  intakeTokenHash       String
  expiresAt             DateTime @db.Timestamptz(3)
  createdAt             DateTime @default(now()) @db.Timestamptz(3)

  @@index([expiresAt])
  @@index([intakeTokenHash])
}

model AuthSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  userAgent  String?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}
