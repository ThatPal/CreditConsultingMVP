}

model ReviewPlan {
  id                     String           @id @default(uuid()) @db.Uuid
  clientId               String           @db.Uuid
  frequency              ReviewFrequency
  status                 ReviewPlanStatus @default(ACTIVE)
  price                  Decimal          @db.Decimal(12, 2)
  currency               String           @default("USD")
  paymentProvider        PaymentProvider
  providerSubscriptionId String?
  startedAt              DateTime         @default(now())
  nextReviewAt           DateTime?
  endedAt                DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  client                 Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@index([clientId, status])
}

model ClientGoal {
  id                 String                @id @default(uuid()) @db.Uuid
  clientId           String                @db.Uuid
  goalType           GoalType
  scope              GoalScope
  targetAmount       Decimal?              @db.Decimal(14, 2)
  currentAmount      Decimal?              @db.Decimal(14, 2)
  allowAnnualFee     Boolean               @default(false)
  cardTypePreference CardTypePreference    @default(NO_PREFERENCE)
  offerPreferences   GoalOfferPreference[] @default([])
  feePreference      FeePreference         @default(NO_ANNUAL_FEE_ONLY)
  preferenceNote     String?               @db.VarChar(500)
  priority           GoalPriority
  status             GoalStatus            @default(ACTIVE)
  version            Int                   @default(1)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  achievedAt         DateTime?
  client             Client                @relation(fields: [clientId], references: [id], onDelete: Restrict)
  revisions          ClientGoalRevision[]

  @@unique([clientId, goalType, scope])
  @@index([clientId, status, priority])
}

model ClientGoalRevision {
  id                 String                @id @default(uuid()) @db.Uuid
  goalId             String                @db.Uuid
  clientId           String                @db.Uuid
  version            Int
  goalType           GoalType
  scope              GoalScope
  targetAmount       Decimal?              @db.Decimal(14, 2)
  allowAnnualFee     Boolean
  cardTypePreference CardTypePreference    @default(NO_PREFERENCE)
  offerPreferences   GoalOfferPreference[] @default([])
  feePreference      FeePreference         @default(NO_ANNUAL_FEE_ONLY)
  preferenceNote     String?               @db.VarChar(500)
  priority           GoalPriority
  status             GoalStatus
  changedById        String?               @db.Uuid
  changeSource       String                @default("CLIENT_COMMAND")
  createdAt          DateTime              @default(now()) @db.Timestamptz(3)
  goal               ClientGoal            @relation(fields: [goalId], references: [id], onDelete: Restrict)
  client             Client                @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@unique([goalId, version])
  @@index([clientId, createdAt])
}

model AnonymousGoalIntake {
  id                 String                @id @default(uuid()) @db.Uuid
  tokenHash          String                @unique
  goalType           GoalType
  scope              GoalScope
  targetAmount       Decimal               @db.Decimal(14, 2)
  allowAnnualFee     Boolean               @default(false)
  cardTypePreference CardTypePreference    @default(NO_PREFERENCE)
  offerPreferences   GoalOfferPreference[] @default([])
  feePreference      FeePreference         @default(NO_ANNUAL_FEE_ONLY)
  preferenceNote     String?               @db.VarChar(500)
  firstName          String                @db.VarChar(100)
  lastName           String                @db.VarChar(100)
  email              String                @db.VarChar(320)
  phone              String?               @db.VarChar(32)
  version            Int                   @default(1)
  expiresAt          DateTime              @db.Timestamptz(3)
  consumedAt         DateTime?             @db.Timestamptz(3)
  consumedByClientId String?               @db.Uuid
  createdAt          DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime              @updatedAt @db.Timestamptz(3)
  consumedByClient   Client?               @relation(fields: [consumedByClientId], references: [id], onDelete: Restrict)

  @@index([expiresAt, consumedAt])
  @@index([consumedByClientId])
}

model GoalIntakeRegistrationClaim {
  id                    String   @id @default(uuid()) @db.Uuid
  registrationEmailHash String   @unique
  intakeTokenHash       String
  expiresAt             DateTime @db.Timestamptz(3)
  createdAt             DateTime @default(now()) @db.Timestamptz(3)

  @@index([expiresAt])
  @@index([intakeTokenHash])
}

model AuthSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  userAgent  String?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}
