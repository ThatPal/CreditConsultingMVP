{
  "name": "@credit/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --maxWorkers=1 --exclude src/commerce/commerceIntegrity.integration.test.ts --exclude src/plans/reconciliation.integration.test.ts --exclude src/workspace/live.integration.test.ts --exclude src/goals/entryF1.integration.test.ts --exclude src/goals/goalIntake.integration.test.ts",
    "test:commerce-integrity": "vitest run --maxWorkers=1 src/commerce/commerceIntegrity.integration.test.ts",
    "test:astra-isolated": "vitest run --maxWorkers=1 src/plans/reconciliation.integration.test.ts src/workspace/live.integration.test.ts",
    "test:unit": "vitest run",
    "test:integration": "vitest run src/app.test.ts",
    "test:entry-f1": "node ../../scripts/entry-f1-guard.mjs && vitest run --maxWorkers=1 src/goals/entryF1.integration.test.ts src/goals/goalIntake.integration.test.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.2",
    "@credit/runtime": "workspace:*",
    "@credit/shared": "workspace:*",
    "@prisma/adapter-pg": "latest",
    "@prisma/client": "7.9.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.45.1",
    "better-auth": "^1.7.2",
    "bullmq": "^6.3.2",
    "cookie-parser": "^1.4.7",
    "cors": "latest",
    "dotenv": "latest",
    "express": "5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "latest",
    "pino": "latest",
    "pino-http": "latest",
    "redis": "5.11.0",
    "socket.io": "^4.8.3",
    "stripe": "^22.6.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/supertest": "latest",
    "socket.io-client": "^4.8.3",
    "supertest": "latest",
    "tsx": "latest",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
