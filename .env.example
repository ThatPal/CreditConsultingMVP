NODE_ENV=development
PORT=3001
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3001
DATABASE_URL=postgresql://credit:credit_dev@localhost:5433/credit_strategy?schema=public
REDIS_URL=redis://localhost:6380
SESSION_COOKIE_NAME=credit_sid
SESSION_TTL_HOURS=168
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_BASE_URL=http://localhost:5173/reset-password
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=5
MFA_STEP_UP_TTL_MINUTES=15
EMAIL_PROVIDER=CONSOLE
EMAIL_FROM=no-reply@example.invalid
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD_SECRET_REF=secret://email/smtp-password
DOCUMENT_STORAGE_PROVIDER=LOCAL_DISK
DOCUMENT_STORAGE_DIR=.data/documents
# PayPal sandbox only. Secrets must remain environment-managed.
PAYPAL_ENVIRONMENT=SANDBOX
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYMENT_DEFAULT_PROVIDER=PAYPAL
STRIPE_ENVIRONMENT=TEST
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
