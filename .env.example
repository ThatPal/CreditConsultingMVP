NODE_ENV=development
PORT=3015
LOG_LEVEL=info
WEB_ORIGIN=http://127.0.0.1:5195
VITE_API_URL=http://127.0.0.1:3015
DATABASE_URL=postgresql://credit:credit_astra_dev@127.0.0.1:5445/credit_strategy_astra?schema=public
REDIS_URL=redis://127.0.0.1:6395
SESSION_COOKIE_NAME=credit_astra_sid
SESSION_TTL_HOURS=168
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_BASE_URL=http://127.0.0.1:5195/reset-password
BETTER_AUTH_URL=http://127.0.0.1:3015
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=5
MFA_STEP_UP_TTL_MINUTES=15
EMAIL_PROVIDER=CONSOLE
EMAIL_FROM=no-reply@example.invalid
# EMAIL_SMTP_HOST is set only when a real SMTP transport is configured.
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=true
# Omit optional SMTP username unless configured; an empty value is invalid.
EMAIL_SMTP_PASSWORD_SECRET_REF=secret://email/smtp-password
DOCUMENT_STORAGE_PROVIDER=LOCAL_DISK
DOCUMENT_STORAGE_DIR=.data/documents
# PayPal sandbox only. Secrets must remain environment-managed.
PAYPAL_ENVIRONMENT=SANDBOX
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYMENT_DEFAULT_PROVIDER=PAYPAL
STRIPE_ENVIRONMENT=TEST
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BOFA_ENVIRONMENT=SANDBOX
BOFA_HOSTED_URL=https://testsecureacceptance.cybersource.com/pay
BOFA_ACCESS_KEY=
BOFA_PROFILE_ID=
BOFA_SECRET_KEY=
